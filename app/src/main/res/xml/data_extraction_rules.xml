<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+. The locked folder is never uploaded to a cloud backup; a direct transfer to a new phone
    (cable or local Wi-Fi) keeps it, so it isn't lost when changing phones.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="locked/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="locked/" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
